{
  "name": "agent",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run db:deploy --workspace=@workspace/db",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run db:deploy --workspace=@workspace/db",
    "start": "node dist/server.js",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/core": "*",
    "@workspace/db": "*",
    "dotenv": "^18.0.4",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^20",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
}