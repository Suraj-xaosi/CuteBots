{
  "name": "@workspace/core",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@qdrant/js-client-rest": "1.18.0",
    "@workspace/types": "*",
    "js-tiktoken": "^1.0.21",
    "mem0ai": "^3.3.1",
    "openai": "^7.25.0",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/typescript-config": "*",
    "tsx": "^4.20.3",
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js"
