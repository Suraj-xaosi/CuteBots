generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id               String                 @id @default(cuid())
  name             String
  repo_url         String
  context          String                 @default("")
  github_token     String?                @map("clone_credential")
  container_id     String?
  active_task_id   String?
  branch_name      String?
  sandbox_status   SandboxStatus          @default(STOPPED)
  provision_status ProjectProvisionStatus @default(PENDING)
  provision_error  String?
  created_at       DateTime               @default(now())
  updated_at       DateTime               @updatedAt
  tasks            Task[]
}

model Task {
  id                 String     @id @default(cuid())
  project_id         String
  project            Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  description        String
  status             TaskStatus @default(RUNNING)
  completion_summary String?
  fail_reason        String?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt
  started_at         DateTime   @default(now())
  completed_at       DateTime?
  messages           Message[]
  logs               AgentLog[]

  @@index([project_id, created_at])
  @@index([status])
}

model Message {
  id           String      @id @default(cuid())
  task_id      String
  task         Task        @relation(fields: [task_id], references: [id], onDelete: Cascade)
  role         MessageRole
  content      String
  tool_calls   String?
  tool_call_id String?
  created_at   DateTime    @default(now())

  @@index([task_id, created_at])
}

model AgentLog {
  id         Int      @id @default(autoincrement())
  task_id    String
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)
  type       String
  content    String
  created_at DateTime @default(now())

  @@index([task_id, id])
}

model Setting {
  key        String   @id
  value      String
  is_secret  Boolean  @default(false)
  updated_at DateTime @updatedAt
}

enum ProjectProvisionStatus {
  PENDING
  PROVISIONING
  READY
  FAILED
}

enum TaskStatus {
  RUNNING
  INTERRUPTED
  AWAITING_APPROVAL
  DONE
  FAILED
}

enum SandboxStatus {
  RUNNING
  STOPPED
}

enum MessageRole {
  user
  assistant
  tool
}
